{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "site": {
      "root": "web-demo/site",
      "outputDirectory": "public"
    },
    "demo_api": {
      "root": "web-demo/api",
      "framework": "flask",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "demo_api" } },
    { "source": "/(.*)", "destination": { "service": "site" } }
  ]
}
